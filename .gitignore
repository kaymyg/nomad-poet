# Foundry build output - regenerated by `forge build`, never commit
out/
cache/
broadcast/

# Local Foundry config that may reference machine paths
.env
*.env

# Windows noise
Thumbs.db
desktop.ini

# NOTE: keystores live in ~/.foundry/keystores, NOT in this folder,
# so there is nothing key-shaped here to ignore. But if you ever create a
# .env or keystore file inside the project, the rules above cover it.
